{
  "name": "@crab/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --import tsx src/index.ts",
    "dev": "node --import tsx --watch src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@crab/channel-whatsapp": "workspace:*",
    "@crab/core": "workspace:*",
    "@crab/llm": "workspace:*",
    "@crab/security": "workspace:*",
    "@crab/storage": "workspace:*",
    "@fastify/rate-limit": "^10.1.1",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
