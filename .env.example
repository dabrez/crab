# Crab — copy to .env and fill in. Never commit a real .env.

# ----- Server -----
CRAB_HOST=0.0.0.0
CRAB_PORT=3000
CRAB_PUBLIC_URL=https://your-public-host.example.com
CRAB_LOG_LEVEL=info
CRAB_WORKSPACE_DIR=~/.crab/workspace

# ----- WhatsApp Business Cloud API -----
# From Meta App dashboard → WhatsApp → Configuration
WHATSAPP_APP_SECRET=
# System User access token (long-lived)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Generated by `crab onboard`; supply your own to override
WHATSAPP_VERIFY_TOKEN=
# Cloud API version
WHATSAPP_API_VERSION=v22.0

# ----- LLM provider -----
# Default: Anthropic Claude
ANTHROPIC_API_KEY=
CRAB_LLM_PROVIDER=anthropic
CRAB_LLM_MODEL=claude-opus-4-7

# ----- Security -----
# Comma-separated extra hosts allowed for outbound HTTPS (in addition to
# graph.facebook.com and the configured LLM provider host).
CRAB_EGRESS_ALLOWLIST=
# 'enforce' rejects new destinations; 'approve' queues for operator approval.
CRAB_EGRESS_MODE=approve
# Max webhook body size in bytes
CRAB_WEBHOOK_MAX_BODY_BYTES=1048576
# Reject webhooks whose timestamp is older than this many seconds (replay window)
CRAB_WEBHOOK_REPLAY_WINDOW_S=300
